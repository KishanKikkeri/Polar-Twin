# POLARTWIN backend environment variables
# Copy to .env in this directory or set in your environment.

POLARTWIN_APP_NAME="POLARTWIN Digital Twin API"
POLARTWIN_ENVIRONMENT=development

# Database connection:
# For local PostgreSQL (e.g. docker compose up -d):
# POLARTWIN_DATABASE_URL=postgresql+psycopg://polartwin:polartwin@localhost:5432/polartwin
#
# For zero-setup local SQLite file:
POLARTWIN_DATABASE_URL=sqlite:///polartwin.db

# Echo SQL queries (useful for debugging)
POLARTWIN_DATABASE_ECHO=false

# CORS allowed origins (JSON list or comma-separated if supported)
# Defaults to Vite dev server: http://localhost:5173
POLARTWIN_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Query pagination defaults
POLARTWIN_TELEMETRY_DEFAULT_LIMIT=500
POLARTWIN_TELEMETRY_MAX_LIMIT=5000
