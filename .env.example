# Copy this file to .env and fill in your OpenWeather API key.
# Get a free key at https://openweathermap.org/api
#
# If this is left unset, POLARTWIN will fall back to clearly-labeled
# simulated weather values instead of crashing.
VITE_OPENWEATHER_API_KEY=

# Base URL of the POLARTWIN backend API (v1 integration contract).
# If unset, the dev default http://localhost:8000 is used. Only VITE_-prefixed
# variables are exposed to the browser: never put secrets here.
VITE_API_BASE_URL=http://localhost:8000
